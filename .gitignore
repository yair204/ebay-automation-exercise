__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
allure-report/

# Run artifacts are regenerated by every run and are far too large to commit
# (traces alone exceed 180MB). Note this must be `reports/*`, not `reports/`:
# git will not descend into an excluded directory, so a negation below it is
# ignored unless the directory itself stays traversable.
reports/*
!reports/.gitkeep

# ...except one curated sample run, so the submission ships a real report.
!reports/sample-run/

# macOS
.DS_Store
